apiVersion: v1
kind: Secret
metadata:
  name: glidepath-secrets
type: Opaque
stringData:
  DATABASE_URL: "postgres://user:password@host:5432/glidepath?sslmode=disable"
  OIDC_ISSUER: ""
  OIDC_AUDIENCE: ""
  OIDC_CLIENT_ID: ""
  OIDC_CLIENT_SECRET: ""
  OIDC_REDIRECT_URL: ""
  OIDC_ALLOWED_EMAILS: ""
  ANTHROPIC_API_KEY: ""
